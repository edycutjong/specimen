{
  "name": "specimen-jar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "servers/*",
    "apps/*",
    "spikes/*"
