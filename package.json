{
  "name": "specimen-jar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "servers/*",
    "apps/*",
    "spikes/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "spike:s1": "npm run -w spikes/s1-browser check",
    "seed:check": "tsx scripts/seed-check.ts",
    "bench": "tsx scripts/bench.ts",
    "build:site": "npm run build -w apps/cabinet && vite build --config site/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
